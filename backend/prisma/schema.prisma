// Prisma schema: the single source of truth for our database structure.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet       Wallet?
  orders       Order[]
  positions    Position[]
  transactions Transaction[]

  @@map("users")
}

model Wallet {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  cashBalance Decimal  @map("cash_balance") @db.Decimal(18, 2)
  currency    String   @default("USD") @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Stock {
  id           String   @id @default(uuid(7)) @db.Uuid
  symbol       String   @unique @db.VarChar(10)
  name         String
  currentPrice Decimal  @map("current_price") @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders       Order[]
  positions    Position[]
  transactions Transaction[]

  @@map("stocks")
}

enum OrderSide {
  BUY
  SELL
}

// MARKET: now, at the current price. LIMIT: only at limitPrice or better;
// waits as PENDING until the price gets there (or the user cancels it).
// STOP: waits until the price crosses stopPrice, then executes at market
// (e.g. a SELL stop below the price limits a loss).
enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  FILLED
  REJECTED
  CANCELLED
}

// What the user asked for, and what happened to it
model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  stockId        String      @map("stock_id") @db.Uuid
  side           OrderSide
  type           OrderType   @default(MARKET)
  quantity       Int
  // LIMIT only: buy at this price or lower / sell at this price or higher
  limitPrice     Decimal?    @map("limit_price") @db.Decimal(18, 2)
  // STOP only: a BUY triggers at or above it, a SELL at or below it
  stopPrice      Decimal?    @map("stop_price") @db.Decimal(18, 2)
  // Execution price; stays null until the order is FILLED
  price          Decimal?    @db.Decimal(18, 2)
  // Simulated commission, charged when it fills (0 until then)
  fee            Decimal     @default(0) @db.Decimal(18, 2)
  status         OrderStatus @default(PENDING)
  rejectReason   String?     @map("reject_reason")
  // Client-generated (Idempotency-Key header): a retried request with the
  // same key returns this order instead of trading twice
  idempotencyKey String?     @map("idempotency_key") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  executedAt     DateTime?   @map("executed_at")

  user        User         @relation(fields: [userId], references: [id])
  stock       Stock        @relation(fields: [stockId], references: [id])
  transaction Transaction?

  // Per user: two users may pick the same key. NULLs never collide in Postgres,
  // so orders sent without a key are not affected.
  @@unique([userId, idempotencyKey])
  // GET /orders lists a user's orders newest first
  @@index([userId, createdAt])
  // The limit-order matcher looks for PENDING orders every few seconds
  @@index([status, stockId])
  @@map("orders")
}

// How many shares of a stock a user currently holds
model Position {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  stockId      String   @map("stock_id") @db.Uuid
  quantity     Int
  // More decimals than prices: an average of several buys is rarely a round cent
  averagePrice Decimal  @map("average_price") @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  // At most one position per user per stock (BUY updates it, never duplicates it)
  @@unique([userId, stockId])
  @@map("positions")
}

enum TransactionType {
  BUY
  SELL
}

// Immutable audit trail of executed trades: no updatedAt, never updated or deleted
model Transaction {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  orderId   String          @unique @map("order_id") @db.Uuid
  stockId   String          @map("stock_id") @db.Uuid
  type      TransactionType
  quantity  Int
  price     Decimal         @db.Decimal(18, 2)
  // price * quantity, before the fee
  amount    Decimal         @db.Decimal(18, 2)
  // Commission. Cash moved: amount + fee on a BUY, amount - fee on a SELL
  fee       Decimal         @default(0) @db.Decimal(18, 2)
  createdAt DateTime        @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  @@index([userId, createdAt])
  @@map("transactions")
}

// Transactional outbox: an event is written in the SAME database transaction as
// the change it describes (e.g. a filled order), so it's saved if and only if
// that change is. OutboxRelay then publishes it to RabbitMQ.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  // Also the RabbitMQ routing key, e.g. "order.filled"
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  // null = not published yet
  publishedAt DateTime? @map("published_at")

  // The relay asks for "unpublished, oldest first"
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
