PORT=3000
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
POSTGRES_DB=paper_trading
POSTGRES_PORT=5432
DATABASE_URL="postgresql://trading:change_me@localhost:5432/paper_trading?schema=public"

# Redis (cache)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# RabbitMQ (events). Management UI: http://localhost:15672
RABBITMQ_USER=trading
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL="amqp://trading:change_me@localhost:5672"

# JWT Configuration
JWT_SECRET="change_me_to_a_random_string_at_least_32_characters_long"
JWT_EXPIRES_IN="15m"

# App environment: development | production | test
NODE_ENV=development

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Security
# Browser origins allowed to call the API (comma-separated). Empty = no CORS.
# Not needed in development: the Vite dev server proxies /api to the backend,
# so the browser only ever talks to http://localhost:5173 (same origin).
CORS_ORIGINS=
# Rate limiting is on by default (off only when NODE_ENV=test)
# RATE_LIMIT_ENABLED=true

# Mail (password reset links). In development Mailpit (docker compose)
# catches every message: inbox at http://localhost:8025, nothing reaches a
# real address. Required in production, e.g. Amazon SES:
# SMTP_URL="smtps://<user>:<password>@email-smtp.<region>.amazonaws.com:465"
# SMTP_URL="smtp://localhost:1025"
# MAIL_FROM="Paper Trading <no-reply@paper-trading.local>"
# SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# Where the browser app runs: password reset links point here.
# Default http://localhost:5173. Required in production.
# FRONTEND_URL=http://localhost:5173

# Market data provider: simulated (default, generated prices, no key) or
# alpaca (real prices, free plan: IEX exchange only, 200 requests/min).
# The e2e tests always use simulated.
MARKET_DATA_PROVIDER=simulated
# Alpaca keys (https://alpaca.markets, a free paper account is enough).
# Backend only: never put them in the frontend. Required for alpaca.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# Market data API (not paper-api.alpaca.markets, which is for orders)
# ALPACA_DATA_URL=https://data.alpaca.markets

# How often (ms) provider prices are copied into the stocks table, the prices
# orders execute at, and pushed live over the WebSocket. 0 = off.
# Default: 1000 (simulated), 2000 (alpaca), and off when NODE_ENV=test.
# MARKET_DATA_SYNC_INTERVAL_MS=1000

# How often (ms) waiting LIMIT/STOP orders are checked against the current
# price. 0 = off. Default: 2000, and off when NODE_ENV=test.
# LIMIT_ORDER_MATCH_INTERVAL_MS=2000

# Simulated execution rules. Defaults below; all off when NODE_ENV=test.
# Commission: $0.005/share, min $1, max 1% of the trade
# TRADING_FEES_ENABLED=true
# Market fills this many basis points worse than the last price (5 = 0.05%)
# TRADING_SLIPPAGE_BPS=5
# Market orders only while the US market is open; LIMIT/STOP wait for it
# TRADING_MARKET_HOURS=true

# The e2e tests use <POSTGRES_DB>_test and Redis db 1 by default. Override:
# TEST_DATABASE_URL="postgresql://trading:change_me@localhost:5432/paper_trading_test?schema=public"
# TEST_REDIS_URL="redis://localhost:6379/1"
