# Copy this file to .env and fill in the values: cp .env.example .env

# App
PORT=3000

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
POSTGRES_DB=paper_trading
POSTGRES_PORT=5432

# Prisma connection string (must match the values above)
DATABASE_URL="postgresql://trading:change_me@localhost:5432/paper_trading?schema=public"
